.claude/

# Override local de Docker Compose (puertos/ajustes propios de una máquina) — no versionar
docker-compose.override.yml

# Logs y temporales
*.log
*.tmp
diagnostico.txt

# Resultados de `dotnet test` (artefactos de build, uno por corrida local)
TestResults/

# OS
Thumbs.db
.DS_Store

# Documentos de trabajo local, no se versionan
docs/diccionario-datos-nexo.md

# Histórico oficial de SICE-TAC (excels ~100-180 MB c/u) — cada archivo supera
# el límite de 100 MB de GitHub. Pendiente: manifiesto + almacenamiento externo
# o Git LFS (ver analitica/04-comparativa-y-propuesta-modelo/recomendacion_captura_datos.md).
# Cubre las 2 carpetas que llegó a tener (2 sesiones en paralelo, nombres distintos)
# y el patrón de archivo en cualquier ruta, por seguridad.
analitica/00-fuentes/Historicos_SICE/
analitica/00-fuentes/historico-sicetac/*.xlsx
**/SICETAC_*.xlsx

# Excels y CSV de negocio y de clientes (licitaciones, tarifas, costos, precios): datos comerciales,
# nunca al repo público. Se guardan solo en local; de aquí leen el dataset de evaluación de la IA y la
# generación de precios de venta.
docs/docs_raw/
database/seeder/Libro1.xlsx

# Archivos temporales de Office (se crean mientras un Excel/Word está abierto)
~$*

# Exports crudos de tablas reales (SICE-TAC, plaza, tarifas) para verificación puntual — nunca al repo público
docs/tbl*.csv

# Dataset dorado (#353): de qué Excel real sale cada caso — los nombres de archivo y hoja identifican al cliente
tests/evaluacion-ia/dataset/fuentes.local.json

# Precios de venta (S6-HU-38/#407): nunca al repo público. El CSV con precios se genera
# en local a partir de los Excel de precios (script local, no versionado).
database/seeder/*.local.csv
