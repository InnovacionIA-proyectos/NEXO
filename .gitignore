*.egg-info/

# Configuración local / secretos — NUNCA se versionan
appsettings.*.local.json
.env
.env.*
!.env.example
!.env.dokploy
!.env.githubSECRETS

# Configuración local de Claude Code (permisos, hosts internos, launch.json
