# ============================================================================
# Nexo (Clean Architecture) — arnés de compilación y pruebas
#
# Este archivo NO produce la imagen que va a producción: de eso se encarga
# src/Nexo.Api/Dockerfile, que publica únicamente el proyecto Api.
#
# Aquí se compila la SOLUCIÓN COMPLETA — las 4 capas más los 3 proyectos de
# test — para verificar que "dotnet build termina sin errores" sin depender
# del SDK instalado en la máquina de quien lo corre.
#
# Contexto de build esperado: la RAÍZ del repositorio.
#   docker compose -f docker-compose.ci.yml build
#   docker compose -f docker-compose.ci.yml run --rm build
# ============================================================================

FROM mcr.microsoft.com/dotnet/sdk:10.0

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

WORKDIR /src

# La solución y los 7 .csproj van primero: mientras solo cambie código, Docker
# reutiliza la capa del restore y no vuelve a bajar los paquetes de NuGet.
COPY ["Nexo.Clean.sln", "./"]
COPY ["src/Nexo.Domain/Nexo.Domain.csproj",                         "src/Nexo.Domain/"]
COPY ["src/Nexo.Mensajes/Nexo.Mensajes.csproj",                     "src/Nexo.Mensajes/"]
COPY ["src/Nexo.Application/Nexo.Application.csproj",               "src/Nexo.Application/"]
COPY ["src/Nexo.Infrastructure/Nexo.Infrastructure.csproj",         "src/Nexo.Infrastructure/"]
COPY ["src/Nexo.Api/Nexo.Api.csproj",                               "src/Nexo.Api/"]
COPY ["tests/Nexo.Domain.Tests/Nexo.Domain.Tests.csproj",           "tests/Nexo.Domain.Tests/"]
COPY ["tests/Nexo.Application.Tests/Nexo.Application.Tests.csproj", "tests/Nexo.Application.Tests/"]
COPY ["tests/Nexo.Api.Tests/Nexo.Api.Tests.csproj",                 "tests/Nexo.Api.Tests/"]

RUN dotnet restore "Nexo.Clean.sln"

# El código fuente. El restore ya quedó resuelto en la capa anterior.
COPY src/       src/
COPY tests/     tests/
COPY docs/      docs/
# ContratoMessageTypeTests.cs lee cubicador/infrastructure/mensajeria/rabbitmq.py
# y cubicador/worker/main.py directo del disco para derivar el messageType/tipo
# real que publica Cubicador — sin esta carpeta, esos 5 tests fallan con
# FileNotFoundException dentro de este contenedor. No hace falta para compilar
# ni para correr el resto de la suite: solo para que ESTOS tests encuentren
# su fuente de verdad Python.
COPY cubicador/ cubicador/

# El build va como comando del contenedor y no como RUN a propósito. Si fuera
# parte de la construcción de la imagen, un error de compilación abortaría el
# `docker build` y el log del compilador saldría mezclado con la salida de
# Docker. Como comando, el log sale limpio por stdout y el código de salida del
# contenedor es el del compilador — que es justo lo que un CI necesita leer.
#
# El comando se puede sobrescribir para correr otra cosa con el mismo entorno:
#   docker compose -f docker-compose.ci.yml run --rm build dotnet test ...
CMD ["dotnet", "build", "Nexo.Clean.sln", "-c", "Release", "--no-restore"]
