# Arnés de compilación y pruebas de Nexo: compila la SOLUCIÓN COMPLETA (4 capas + 3 proyectos de test)
# sin depender del SDK de la máquina. NO produce la imagen de producción (eso es src/Nexo.Api/Dockerfile).
# Contexto de build: la RAÍZ del repositorio.
#   docker compose -f docker-compose.ci.yml build
#   docker compose -f docker-compose.ci.yml run --rm build

FROM mcr.microsoft.com/dotnet/sdk:10.0

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

WORKDIR /src

# La solución y los 7 .csproj van primero: mientras solo cambie código, Docker
# reutiliza la capa del restore y no vuelve a bajar los paquetes de NuGet.
COPY ["Nexo.Clean.sln", "./"]
COPY ["src/Nexo.Domain/Nexo.Domain.csproj",                         "src/Nexo.Domain/"]
COPY ["src/Nexo.Mensajes/Nexo.Mensajes.csproj",                     "src/Nexo.Mensajes/"]
COPY ["src/Nexo.Application/Nexo.Application.csproj",               "src/Nexo.Application/"]
COPY ["src/Nexo.Infrastructure/Nexo.Infrastructure.csproj",         "src/Nexo.Infrastructure/"]
COPY ["src/Nexo.Api/Nexo.Api.csproj",                               "src/Nexo.Api/"]
COPY ["tests/Nexo.Domain.Tests/Nexo.Domain.Tests.csproj",           "tests/Nexo.Domain.Tests/"]
COPY ["tests/Nexo.Application.Tests/Nexo.Application.Tests.csproj", "tests/Nexo.Application.Tests/"]
COPY ["tests/Nexo.Api.Tests/Nexo.Api.Tests.csproj",                 "tests/Nexo.Api.Tests/"]

RUN dotnet restore "Nexo.Clean.sln"

# El código fuente. El restore ya quedó resuelto en la capa anterior.
COPY src/       src/
COPY tests/     tests/
COPY docs/      docs/
# ContratoMessageTypeTests.cs lee cubicador/infrastructure/mensajeria/rabbitmq.py y
# cubicador/worker/main.py del disco; sin esta carpeta esos tests fallan con FileNotFoundException.
# No hace falta para compilar ni para el resto de la suite.
COPY cubicador/ cubicador/

# El build va como CMD y no como RUN: así el log del compilador sale limpio por stdout y el código de
# salida del contenedor es el del compilador, que es lo que un CI necesita leer. Se puede sobrescribir:
#   docker compose -f docker-compose.ci.yml run --rm build dotnet test ...
CMD ["dotnet", "build", "Nexo.Clean.sln", "-c", "Release", "--no-restore"]
