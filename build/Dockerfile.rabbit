# RabbitMQ con el plugin de intercambio con retardo (rabbitmq_delayed_message_exchange).
# MassTransit programa los timeouts de saga a través del broker, y ese plugin de la comunidad no viene
# en la imagen oficial. Con él el reloj vive en el broker y sobrevive a reinicios de la API (un
# planificador en memoria perdería el timeout y dejaría el trabajo en Procesando para siempre).
# La versión del plugin debe coincidir con la línea de RabbitMQ (3.13.x).

FROM rabbitmq:3.13-management-alpine

ARG VERSION_PLUGIN=3.13.0
ARG URL_PLUGIN=https://github.com/rabbitmq/rabbitmq-delayed-message-exchange/releases/download

RUN set -eux; \
    apk add --no-cache --virtual .descarga curl; \
    curl -fsSL -o "$RABBITMQ_HOME/plugins/rabbitmq_delayed_message_exchange-${VERSION_PLUGIN}.ez" \
        "${URL_PLUGIN}/v${VERSION_PLUGIN}/rabbitmq_delayed_message_exchange-${VERSION_PLUGIN}.ez"; \
    apk del .descarga; \
    rabbitmq-plugins enable --offline rabbitmq_delayed_message_exchange
