# =========================================================================
# Nexo (Clean Architecture) — variables de entorno del BACKEND .NET
#
# Copia este archivo a `.env` (o configura las mismas claves como variables
# de entorno del sistema, user-secrets o un Key Vault/Secret Manager en
# producción). NUNCA subas al repositorio un archivo con secretos reales.
#
# ASP.NET Core lee configuración jerárquica con el separador "__" (doble
# guion bajo) para las claves fuera de docker-compose (p. ej.
# ConnectionStrings__Nexo). Docker Compose usa nombres de variable
# planos (sin "__") que luego se interpolan en docker-compose.yml — están
# marcados más abajo bajo "DOCKER COMPOSE".
# =========================================================================

# --- Base de datos principal (SQL Server) -------------------------------
# Cadena de conexión a la BD de Nexo. Migraciones EF Core ya
# incluidas (src/Nexo.Infrastructure/Persistence/Migrations).
#
# Solo el nombre de la BD va acá: NexoDbContext fija
# HasDefaultSchema("db_NEXO") en código, así que las 27 tablas de NEXO
# se crean en ese esquema aunque la BD esté compartida con otra app en 'dbo'.
# Ver docs/Database/ para el DDL completo comentado.
ConnectionStrings__Nexo=Server=localhost;Database=Nexo;Trusted_Connection=True;TrustServerCertificate=True;

# --- Data Warehouse corporativo (SOLO LECTURA, OPCIONALES) --------------
# Ninguna de las tres es obligatoria para levantar la API: si falta alguna,
# el módulo que la usa se degrada solo (503 accionable o Configurado=false),
# nunca rompe el arranque ni la inyección de dependencias.

# Matriz oficial SICE-TAC en vivo (DWSice.dbo.tblRutasSicetac, SQL Server
# 2008 R2). La usa Biblioteca (TarifarioSap/PropuestaTarifa/matriz SICE-TAC).
ConnectionStrings__DwSice=Server=<host>,1433;Database=DWSice;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;

# Histórico de tarifas SAP TM (dbsolucionesTI.dbo.tblSAPTarifasLog). La usa
# Biblioteca (TarifarioSap/PropuestaTarifa) para comparar contra SAP.
ConnectionStrings__DbSolucionesTi=Server=<host>;Database=dbsolucionesTI;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;

# Catálogo de clientes reales (DWCubosOperacionesEBS.dbo.DimBPSolicitante,
# misma instancia que DWSice). La usa Solicitudes/Captura; sin ella, la
# búsqueda de clientes cae a la tabla local.
ConnectionStrings__DwCubos=Server=<host>,1433;Database=DWCubosOperacionesEBS;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;

# --- Conexión SAP nueva: plaza en vivo --------------------------------
# Todavía NO EXISTE ("el equipo de conexiones" no la ha construido): no es
# una cadena de conexión, es un modo. Deshabilitado (default) = exactamente
# el comportamiento anterior, la plaza sigue saliendo de
# DbSolucionesTi (fuente real, sin tocar). Mock = usa el dataset provisional
# de SapTarifaFleteEnVivoMockAdapter, útil en Desarrollo/QA sin
# acceso al DW corporativo. Real: reservado para cuando exista el adaptador
# real — hoy se comporta como Deshabilitado (degrada, nunca falla).
SapTarifaFleteEnVivo__Modo=Deshabilitado

# --- Cubicador (microservicio Python, carpeta cubicador/ de este mismo
# repo) — plan de cargue por colas --------------------------------------
# El plan original (adapter HTTP con ICubicacion3DPort) se descartó: la
# decisión técnica es backend<->motor por colas (MassTransit, mismo RabbitMQ
# que el resto de NEXO, ver docs/mensajeria/CUBICACION.md).
# ICubicacionPort usa ConnectionStrings:RabbitMq, ya definida arriba para el
# resto de la mensajería. Única excepción HTTP saliente, declarada y acotada
# a un solo endpoint: Cubicador3D__OutboundBaseUrl/OutboundApiKey más abajo
# — no reabre la puerta a más llamadas directas.
#
# Excepción: el puente "crear plan desde línea" SÍ es HTTP, pero en sentido
# INVERSO (Cubicador llama a NEXO, no al revés) — GET /api/lineas-solicitud
# /{id}/cubicacion, autenticación de servicio-a-servicio (no la sesión del
# portal). Esta clave debe ser IDÉNTICA a NEXO_CALLBACK_API_KEY en el .env
# del Cubicador (cubicador/.env) — es el mismo secreto compartido, visto
# desde cada lado. Vacía = el endpoint responde 401 a cualquier Bearer
# (fail-closed, ver CubicadorApiKeyAuthenticationHandler).
Cubicador3D__InboundApiKey=

# Segunda excepción HTTP, esta vez en el sentido de
# siempre (NEXO llama a Cubicador) — SOLO para POST/GET /recomendaciones
# (S5-HU-18.1/#273; reemplaza al retirado POST /api/cubicacion). Ningún otro
# endpoint de Cubicación usa esto: el resto sigue siendo estrictamente por
# colas (ver el bloque de arriba). Sin las DOS claves juntas (BaseUrl +
# RecomendacionesApiKey), ese único endpoint responde 503 accionable — nunca
# rompe el arranque.
#
# OJO al fijar OutboundBaseUrl en docker-compose/Dokploy: el servicio HTTP de
# Cubicador se llama "api" en cubicador/docker-compose.yml, e IGUAL que el
# servicio "api" de NEXO (este backend) en el docker-compose.yml raíz — los
# dos se unen a la misma red externa `nexo_internal`. NO asumas que el
# hostname "api" resuelve al Cubicador desde acá: verifica el alias real que
# Docker le da en esa red compartida (o publica un alias propio) antes de
# apuntar esta URL a él. En Desarrollo local sin Docker, el puerto publicado
# por cubicador/docker-compose.yml (CUBICADOR_HOST_PORT, default 8081) sí es
# inequívoco — pero usa "127.0.0.1", NO "localhost": con "localhost" el
# HttpClient de .NET prueba primero ::1 (IPv6), que el proxy de puertos de
# Docker Desktop en Windows no escucha, y cada llamada tarda el Timeout
# completo antes de caer a IPv4 (curl sí resuelve bien con "localhost"; el
# problema es específico de HttpClient — verificado en S5-HU-18.1/#273).
# http://127.0.0.1:8081/.
Cubicador3D__OutboundBaseUrl=

# RecomendacionesApiKey debe ser el mismo valor que CUBICADOR_API_KEY_NEXO en
# cubicador/.env (el Bearer que verificar_origen_sistema valida ahí y de donde
# deriva origenSistema="NEXO" — NO la CUBICADOR_API_KEY genérica, que ese
# endpoint ya no acepta).
Cubicador3D__RecomendacionesApiKey=

# S5-HU-18.6/#278: llave GENÉRICA para los seis passthrough de catálogo de
# cubicador/CONTRATO.md §3.2 (verificar_api_key del lado del Cubicador) — debe
# ser el mismo valor que CUBICADOR_API_KEY en cubicador/.env. Sin ella, los seis
# passthrough responden 503 CATALOGO_CUBICADOR_NO_CONFIGURADO.
Cubicador3D__OutboundApiKey=

# Compuerta de liberación por paridad: sin las TRES claves
# juntas, la función responde 503 "en verificación" y NO se publica nada a
# la cola — nunca hay fallback al PoC original (no operativo). Encenderla es
# responsabilidad del equipo una vez `cubicador-ci.yml` confirme 26/26 en
# los golden tests de paridad.
Cubicacion__ParidadVerificada=
Cubicacion__ParidadEvidencia=
Cubicacion__ParidadFecha=

# --- SMTP corporativo (envío de cotizaciones al comercial) --------------
# Opcional: sin Host/Remitente configurados, la entrega de la cotización
# sigue funcionando pero no envía el correo (lo informa en la respuesta).
# OJO con los nombres: SmtpCorreoAdapter lee estas claves en español
# (Puerto/Remitente/Usuario/Clave), no Port/From/User/Password.
Smtp__Host=smtp.boterosoto.com.co
Smtp__Puerto=587
Smtp__Ssl=true
Smtp__Remitente=cabina-fletes@boterosoto.com.co
Smtp__Usuario=
Smtp__Clave=

# --- Modelo de lenguaje (Anthropic) --------------------------------------
# Opcional. Sin Anthropic__ApiKey la aplicación arranca igual y las funciones de
# IA responden 503 (IA_NO_CONFIGURADA). La llave va SOLO aquí (servidor): nunca en
# el front ni en el repositorio. Cada función nace APAGADA: se enciende con
# Anthropic__Funciones__<Nombre>=true (ImportacionExcel, AsistenteCotizacion,
# ApoyoCubicador). No hay variables para temperature/top_p/top_k: la API los rechaza.
Anthropic__ApiKey=
# Interruptor general: false apaga TODA la IA aunque haya llave y funciones encendidas.
Anthropic__Habilitada=true
# Tope de tokens por persona y por día (hora de Colombia). 0 = sin tope.
Anthropic__LimiteTokensPorUsuarioDia=500000
# Solo si la llave es de toda la organización (no atada a una workspace): el ID wrkspc_... no es un secreto.
Anthropic__WorkspaceId=
Anthropic__Model=claude-sonnet-5-5
# `medium` lo recomienda la evaluacion del mapeo (#363): acierta mas y cuesta menos. `high` sirve igual.
# Es global: lo comparten el mapeo y el asistente de cotizacion.
Anthropic__Effort=medium
Anthropic__RazonamientoAdaptativo=true
Anthropic__TimeoutSegundos=60
Anthropic__MaxReintentos=2
Anthropic__MaxTokensSalida=4096
Anthropic__Funciones__ImportacionExcel=false
Anthropic__Funciones__AsistenteCotizacion=false
Anthropic__Funciones__ApoyoCubicador=false

# Límites de la conversación con el asistente de cotización. Opcionales: sin ellos rigen estos valores.
# Asistente__MaxTurnos: mensajes del usuario por conversación. Asistente__MaxIteracionesHerramientas:
# rondas de consultas que el asistente puede hacer para armar una respuesta.
Asistente__MaxTurnos=20
Asistente__MaxCaracteresMensaje=2000
Asistente__MaxIteracionesHerramientas=6
Asistente__MaxTokensRespuesta=2048
# Minutos que un cambio propuesto por el asistente espera la confirmación, y cuántos puede proponer por respuesta.
Asistente__VigenciaAccionMinutos=30
Asistente__MaxAccionesPorRespuesta=3
# Reglas o preferencias propias que una persona puede tener guardadas para el asistente.
Asistente__MaxPreferencias=20

# --- Autenticación: identidad del portal de la Administración -----------
# Nexo no tiene login propio (docs/contrato-integracion, D1): valida en cada
# petición el encabezado X-Portal-Usuario-Id contra esta tabla de solo
# lectura (usuario de conexión SOLO LECTURA). Reemplaza al esquema Azure AD /
# DevAuthenticationHandler, ya retirado.
#
# Si esta cadena queda vacía, la API usa un adapter local que resuelve la
# identidad contra la tabla Usuarios propia (ver DataSeeder.cs para los ids
# de prueba) — Program.cs EXIGE esta cadena configurada en
# ASPNETCORE_ENVIRONMENT=Production, por seguridad (fail-closed).
ConnectionStrings__IdentidadPortal=Server=<host>;Database=<base-identidad-portal>;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;

# --- CORS ----------------------------------------------------------------
# Orígenes autorizados a consumir la API, separados por coma. Incluye el
# frontend standalone de desarrollo Y el/los dominios del módulo cabina-fletes
# dentro del portal de la Administración: Nexo mantiene su propia
# URL base (ver docs/contrato-integracion/README.md, sección 7 — no hay proxy
# ni mismo dominio), así que la llamada del portal a esta API es cross-origin
# y necesita figurar aquí explícitamente. Sin el origen exacto del portal en
# esta lista, el navegador bloquea la respuesta aunque la API responda 200.
Cors__OrigenesPermitidos=http://localhost:5173,https://<dominio-portal-qa>,https://<dominio-portal-produccion>

# --- Entorno de ejecución -------------------------------------------------
# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development
# URL(s) en las que escucha la API fuera de contenedor (dotnet run).
ASPNETCORE_URLS=http://localhost:5080

# --- Migración/seed automáticos al arrancar (Docker) ---------------------
# Fuera de Docker se usa `dotnet run --project src/Nexo.Api seed`.
# Dentro de Docker, Program.cs honra estas dos claves al arrancar.
Database__MigrateOnStartup=false
Database__SeedOnStartup=false

# Esquema propio de NEXO dentro de la base de ConnectionStrings__Nexo (ver
# clsEsquemaNexo.cs). OBLIGATORIA: sin ella, la app/las migraciones/los tests
# fallan al arrancar con un mensaje claro (fail-closed, sin default en código).
# Compose reutiliza este mismo nombre (con "__") para el contenedor 'api' — no
# tiene el alias corto que sí tienen MIGRATE_ON_STARTUP/SEED_ON_STARTUP más abajo.
# Cambiarla NO migra un esquema existente a otro — sirve para apuntar la app a
# una base NUEVA con otro nombre de esquema sin tocar código.
Database__Esquema=db_NEXO

# =========================================================================
# DOCKER COMPOSE — interpolación de docker-compose.yml
# OJO: compose usa ESTOS nombres (sin "__"), no los de arriba. Son los que
# hay que definir en tu .env real (o en Dokploy/tu plataforma > Environment)
# para levantar `docker compose up`.
# =========================================================================

# Servicio 'db' (SQL Server local en contenedor) DESHABILITADO en
# docker-compose.yml: se usa una BD de pruebas/producción real vía
# ConnectionStrings__Nexo (arriba), no un SQL Server local. Estas dos
# claves quedan sin uso mientras tanto; no se eliminan por si hace falta
# volver a levantar 'db' para desarrollo aislado.
# MSSQL_SA_PASSWORD=<clave-fuerte-sin-$-ni-#>
# MSSQL_PID=Developer

# Puerto del host donde se publica la API (no hay frontend en este repo).
API_PORT=8080

# Orígenes permitidos por CORS en el backend contenedorizado, separados por
# coma (frontend standalone + dominio del portal por ambiente — ver la
# variable Cors__OrigenesPermitidos más arriba).
ORIGENES_PERMITIDOS_CORS=http://localhost:5173

# Migrar/sembrar automáticamente al arrancar el contenedor 'api'. Útil para
# levantar un entorno limpio de un solo comando; en producción real, poner
# SEED_ON_STARTUP=false una vez cargados los datos definitivos.
MIGRATE_ON_STARTUP=
SEED_ON_STARTUP=

# Compuerta de liberación del plan de cargue por paridad (ver arriba, sección
# Cubicador). Vacías por defecto: la función queda en verificación.
CUBICACION_PARIDAD_VERIFICADA=
CUBICACION_PARIDAD_EVIDENCIA=
CUBICACION_PARIDAD_FECHA=

# Bearer que valida las llamadas ENTRANTES del Cubicador (crear-desde-línea, ver
# arriba). Debe ser idéntica a NEXO_CALLBACK_API_KEY en cubicador/.env.
CUBICADOR3D_INBOUND_API_KEY=

# Única llamada HTTP SALIENTE de NEXO hacia Cubicador (POST
# /api/cubicacion). Ver el aviso de arriba (sección Cubicador) sobre el
# hostname "api" ambiguo entre los dos docker-compose.yml — no lo uses acá.
# OutboundApiKey debe ser idéntica a CUBICADOR_API_KEY en cubicador/.env.
CUBICADOR3D_OUTBOUND_BASE_URL=
CUBICADOR3D_OUTBOUND_API_KEY=

# Conexión SAP nueva: plaza en vivo (ver arriba). Deshabilitado por
# defecto: la plaza real sigue saliendo de DbSolucionesTi, sin tocar.
SAP_TARIFA_FLETE_EN_VIVO_MODO=Deshabilitado

# ---------------------------------------------------------------------------
# RabbitMQ — broker de la mensajería asíncrona (MassTransit + Outbox).
#
# En desarrollo lo levanta docker-compose. Cuando IT entregue el broker
# corporativo, solo cambia ConnectionStrings__RabbitMq: el código no
# se toca, porque el comportamiento es el mismo.
# ---------------------------------------------------------------------------
RABBITMQ_USER=
# Obligatoria: sin ella el contenedor de rabbit no arranca.
RABBITMQ_PASSWORD=
# Consola de administración (colas, mensajes atascados, cola de error).
RABBITMQ_UI_PORT=

# ---------------------------------------------------------------------------
# Recálculo del score de priorización.
#
# El reloj vive en el broker, dentro de una saga, no en el proceso del API. Por eso
# esto solo cambia cada cuánto suena: no hay temporizador en memoria que se duplique
# al escalar a más de una réplica.
#
# El intervalo se acota entre 1 y 1440 minutos: por debajo deja de ser un refresco y
# es carga constante sobre la base; por encima no refresca nada.
# ---------------------------------------------------------------------------
SCORE_INTERVALO_MINUTOS=15
# Solicitudes por lote. Por lotes y no todas de golpe para no dejar una transacción
# larga bloqueando filas que la bandeja está leyendo.
SCORE_TAMANO_LOTE=200

# ---------------------------------------------------------------------------
# Microservicio de correo MailSender.
#
# POR QUÉ NO SMTP DIRECTO: el relay corporativo por SOAP solo adjunta archivos que
# ya están en una ruta alcanzable por ese servidor, y el formato de la cotización
# llega como archivo en la petición — no está en ningún disco compartido. El
# MailSender lo recibe por multipart y lo encola.
#
# LA URL CAMBIA EN CADA DESPLIEGUE y el servicio sigue funcionando igual, por eso va
# aquí y no en el código. Sin ella, la salida de correo cae al SMTP directo de la
# sección Smtp de arriba.
#
# El servicio no tiene autenticación en v1: solo debe exponerse en red interna.
MAILSENDER_BASE_URL=
# Remitente. Opcional: el relay tiene el suyo por defecto.
MAILSENDER_REMITENTE=
# Tiempo máximo de espera. El MailSender solo encola y responde 202, así que si tarda
# más que esto conviene reintentar en vez de seguir esperando. Acotado entre 5 y 120.
MAILSENDER_TIMEOUT_SEGUNDOS=30

# Destinatario de la prueba de integración con el MailSender. MANDA UN CORREO REAL.
# La prueba (MailSenderRealTests) se salta salvo que esta variable y MAILSENDER_BASE_URL
# estén puestas: una prueba que manda correos en cada corrida acaba silenciada, o peor,
# ignorada por quien los recibe.
#
#   docker compose -f docker-compose.ci.yml run --rm \
#     -e MAILSENDER_BASE_URL=<url> -e MAILSENDER_PRUEBA_DESTINATARIO=<tu correo> \
#     pruebas dotnet test tests/Nexo.Api.Tests -c Release --no-restore \
#     --filter FullyQualifiedName~MailSenderReal
MAILSENDER_PRUEBA_DESTINATARIO=
