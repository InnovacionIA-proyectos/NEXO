# Variables de entorno del backend de NEXO (.NET). Copia este archivo a `.env` y completa los valores.
# Las claves con "__" las lee ASP.NET Core; la sección DOCKER COMPOSE usa nombres planos que interpola docker-compose.yml.
# Nunca subas secretos reales al repositorio.

# --- Base de datos ---
# BD de NEXO (SQL Server). No hay migraciones de EF: el esquema se crea con docs/Database/esquema/ESQUEMA_NEXO.sql.
# Aquí va solo el nombre de la BD; el esquema lo fija Database__Esquema.
ConnectionStrings__Nexo=Server=localhost;Database=Nexo;Trusted_Connection=True;TrustServerCertificate=True;

# --- Data Warehouse corporativo (solo lectura, opcionales) ---
# Si falta alguna, el módulo que la usa se degrada (503 accionable o fuente local); nunca rompe el arranque.
# Matriz SICE-TAC (DWSice).
ConnectionStrings__DwSice=Server=<host>,1433;Database=DWSice;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
# Histórico de tarifas SAP TM (dbsolucionesTI).
ConnectionStrings__DbSolucionesTi=Server=<host>;Database=dbsolucionesTI;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
# Clientes reales (DWCubosOperacionesEBS). Sin ella la búsqueda de clientes usa la tabla local.
ConnectionStrings__DwCubos=Server=<host>,1433;Database=DWCubosOperacionesEBS;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;

# --- Plaza SAP en vivo ---
# Deshabilitado (default): la plaza sale de DbSolucionesTi. Mock: dataset provisional para Desarrollo/QA. Real: reservado, hoy equivale a Deshabilitado.
SapTarifaFleteEnVivo__Modo=Deshabilitado

# --- Cubicador ---
# El plan de cargue va por colas (ConnectionStrings:RabbitMq, ver docs/mensajeria/CUBICACION.md). Las llamadas HTTP son solo las de estas tres claves.
# Bearer de las llamadas ENTRANTES del Cubicador (GET /api/lineas-solicitud/{id}/cubicacion). Igual a NEXO_CALLBACK_API_KEY en cubicador/.env. Vacía = siempre 401.
Cubicador3D__InboundApiKey=
# URL del Cubicador para POST/GET /recomendaciones. Sin BaseUrl y RecomendacionesApiKey ese endpoint responde 503.
# En Docker el servicio "api" existe en los dos docker-compose.yml: verifica el alias real en la red nexo_internal.
# En local usa http://127.0.0.1:8081/ y no localhost: HttpClient prueba primero IPv6 y espera todo el timeout.
Cubicador3D__OutboundBaseUrl=
# Igual a CUBICADOR_API_KEY_NEXO en cubicador/.env; de ella el Cubicador deriva origenSistema=NEXO.
Cubicador3D__RecomendacionesApiKey=
# Llave genérica de los passthrough de catálogo; igual a CUBICADOR_API_KEY en cubicador/.env. Sin ella responden 503 CATALOGO_CUBICADOR_NO_CONFIGURADO.
Cubicador3D__OutboundApiKey=
# Compuerta de paridad del plan de cargue: sin las tres claves la función responde 503 "en verificación" y no publica en la cola.
# Se enciende cuando los golden tests de paridad de cubicador-ci.yml pasan.
Cubicacion__ParidadVerificada=
Cubicacion__ParidadEvidencia=
Cubicacion__ParidadFecha=

# --- SMTP corporativo (envío de cotizaciones) ---
# Opcional: sin Host/Remitente la entrega funciona pero no envía el correo. Los nombres están en español (Puerto, Remitente, Usuario, Clave).
Smtp__Host=smtp.boterosoto.com.co
Smtp__Puerto=587
Smtp__Ssl=true
Smtp__Remitente=cabina-fletes@boterosoto.com.co
Smtp__Usuario=
Smtp__Clave=

# --- Modelo de lenguaje (Anthropic) ---
# Opcional. Sin ApiKey la app arranca y la IA responde 503 (IA_NO_CONFIGURADA). La llave va solo en el servidor.
# Cada función nace apagada (Anthropic__Funciones__<Nombre>=true). No hay temperature/top_p/top_k: la API los rechaza.
Anthropic__ApiKey=
# Interruptor general: false apaga toda la IA.
Anthropic__Habilitada=true
# Tope de tokens por persona y día (hora de Colombia). 0 = sin tope.
Anthropic__LimiteTokensPorUsuarioDia=500000
# Solo si la llave es de toda la organización; el id wrkspc_... no es un secreto.
Anthropic__WorkspaceId=
Anthropic__Model=claude-sonnet-5-5
# Global: lo comparten el mapeo y el asistente. `medium` acierta más y cuesta menos; `high` también sirve.
Anthropic__Effort=medium
Anthropic__RazonamientoAdaptativo=true
Anthropic__TimeoutSegundos=60
Anthropic__MaxReintentos=2
Anthropic__MaxTokensSalida=4096
Anthropic__Funciones__ImportacionExcel=false
Anthropic__Funciones__AsistenteCotizacion=false
Anthropic__Funciones__ApoyoCubicador=false

# Límites del asistente de cotización (opcionales; estos son los valores por defecto).
# MaxTurnos: mensajes del usuario por conversación. MaxIteracionesHerramientas: rondas de consultas por respuesta.
Asistente__MaxTurnos=20
Asistente__MaxCaracteresMensaje=2000
Asistente__MaxIteracionesHerramientas=6
Asistente__MaxTokensRespuesta=2048
# Minutos que un cambio propuesto espera confirmación y cuántos se proponen por respuesta.
Asistente__VigenciaAccionMinutos=30
Asistente__MaxAccionesPorRespuesta=3
# Preferencias guardadas por persona.
Asistente__MaxPreferencias=20

# --- Identidad del portal ---
# NEXO no tiene login: valida en cada petición el header de identidad contra esta tabla (solo lectura).
# Vacía = tabla Usuarios local. En Production es obligatoria (fail-closed).
ConnectionStrings__IdentidadPortal=Server=<host>;Database=<base-identidad-portal>;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;

# --- CORS ---
# Orígenes autorizados, separados por coma: frontend de desarrollo y dominios del portal. Sin el origen exacto el navegador bloquea la respuesta.
Cors__OrigenesPermitidos=http://localhost:5173,https://<dominio-portal-qa>,https://<dominio-portal-produccion>

# --- Entorno ---
# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development
# URL en la que escucha la API fuera de contenedor.
ASPNETCORE_URLS=http://localhost:5080

# --- Arranque (Docker) ---
# Fuera de Docker se siembra con `dotnet run --project src/Nexo.Api seed`.
Database__MigrateOnStartup=false
Database__SeedOnStartup=false
# Esquema de NEXO dentro de la BD. Obligatoria: sin ella la app falla al arrancar. Compose usa este mismo nombre.
Database__Esquema=db_NEXO

# =========================================================================
# DOCKER COMPOSE — nombres planos que interpola docker-compose.yml (no los de arriba)
# =========================================================================
# El servicio 'db' local está deshabilitado en docker-compose.yml: estas dos claves no se usan.
# MSSQL_SA_PASSWORD=<clave-fuerte-sin-$-ni-#>
# MSSQL_PID=Developer

# Puerto del host donde se publica la API.
API_PORT=8080
# Equivale a Cors__OrigenesPermitidos.
ORIGENES_PERMITIDOS_CORS=http://localhost:5173
# Migrar/sembrar al arrancar el contenedor 'api'. En producción deja SEED_ON_STARTUP=false.
MIGRATE_ON_STARTUP=
SEED_ON_STARTUP=
# Compuerta de paridad del plan de cargue (ver Cubicador).
CUBICACION_PARIDAD_VERIFICADA=
CUBICACION_PARIDAD_EVIDENCIA=
CUBICACION_PARIDAD_FECHA=
# Cubicador: INBOUND_API_KEY = Cubicador3D__InboundApiKey; OUTBOUND_* = Cubicador3D__OutboundBaseUrl y OutboundApiKey (ver arriba).
CUBICADOR3D_INBOUND_API_KEY=
CUBICADOR3D_OUTBOUND_BASE_URL=
CUBICADOR3D_OUTBOUND_API_KEY=
# Equivale a SapTarifaFleteEnVivo__Modo.
SAP_TARIFA_FLETE_EN_VIVO_MODO=Deshabilitado

# --- RabbitMQ (MassTransit + Outbox) ---
# En desarrollo lo levanta docker-compose; con el broker corporativo solo cambia ConnectionStrings__RabbitMq.
RABBITMQ_USER=
# Obligatoria: sin ella el contenedor de rabbit no arranca.
RABBITMQ_PASSWORD=
# Consola de administración.
RABBITMQ_UI_PORT=

# --- Recálculo del score de priorización ---
# El reloj vive en el broker (saga), no en el API: escalar réplicas no duplica el temporizador. Intervalo acotado entre 1 y 1440 minutos.
SCORE_INTERVALO_MINUTOS=15
# Solicitudes por lote (evita transacciones largas que bloqueen filas que lee la bandeja).
SCORE_TAMANO_LOTE=200

# --- MailSender (correo) ---
# El relay corporativo solo adjunta archivos de una ruta alcanzable y la cotización llega como archivo en la petición: MailSender la recibe
# por multipart y la encola. Sin URL se usa el SMTP directo de arriba. No tiene autenticación: solo en red interna.
MAILSENDER_BASE_URL=
# Remitente (opcional; el relay tiene uno por defecto).
MAILSENDER_REMITENTE=
# Espera máxima, entre 5 y 120 s. MailSender solo encola y responde 202.
MAILSENDER_TIMEOUT_SEGUNDOS=30
# Destinatario de la prueba de integración (MailSenderRealTests). MANDA UN CORREO REAL; se salta si esta variable o MAILSENDER_BASE_URL faltan.
#   docker compose -f docker-compose.ci.yml run --rm -e MAILSENDER_BASE_URL=<url> -e MAILSENDER_PRUEBA_DESTINATARIO=<tu correo>
#     pruebas dotnet test tests/Nexo.Api.Tests -c Release --no-restore --filter FullyQualifiedName~MailSenderReal
MAILSENDER_PRUEBA_DESTINATARIO=
