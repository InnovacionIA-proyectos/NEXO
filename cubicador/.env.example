# Copiar a .env (gitignored) y completar con valores reales.
# Ver DECISIONES_TECNICAS.md #7 (autenticacion) y #9 (RabbitMQ).

# --- Base de datos propia ---
POSTGRES_PASSWORD=

# --- RabbitMQ (broker COMPARTIDO de NEXO, no un contenedor propio - ver
# DECISIONES_TECNICAS.md #9). Deben ser los MISMOS valores que RABBITMQ_USER/
# RABBITMQ_PASSWORD en el .env de la raiz de NEXO: es el mismo broker. ---
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# --- Autenticacion servicio-a-servicio (ver CONTRATOS.md seccion D) ---
# Valida las llamadas ENTRANTES desde NEXO (Authorization: Bearer <esto>).
CUBICADOR_API_KEY=
# Se usa al llamar DE VUELTA a NEXO (puente Solicitudes -> Cubicador).
NEXO_CALLBACK_API_KEY=

# --- Donde vive NEXO (para el endpoint de lineas de solicitud) ---
NEXO_BASE_URL=http://localhost:5080

# --- Puerto publicado al host para docker-compose (el contenedor sigue
# escuchando en 8000 puertas adentro). 8081 por defecto para no chocar con
# el 8080 donde corre el backend .NET; cambiar a 8082 si hace falta. ---
CUBICADOR_HOST_PORT=8081

# --- CORS: origenes autorizados a llamar esta API directamente desde un
# frontend (no hace falta para el backend .NET, que habla por colas). Vacio
# = sin middleware CORS (comportamiento anterior, solo server-to-server). ---
CUBICADOR_CORS_ORIGENES=http://localhost:5173

# --- Alerta por correo al caer un mensaje en cubicacion.dlq (ver
# infrastructure/alertas/correo.py). Todas opcionales: sin ALERTAS_SMTP_HOST
# el worker sigue funcionando igual, solo deja de mandar el correo (log
# warning en su lugar). ALERTAS_EQUIPO_TECNICO vacio usa el default del
# codigo (el mismo equipo que ya recibe la alerta equivalente en NEXO). ---
ALERTAS_SMTP_HOST=
ALERTAS_SMTP_PUERTO=587
ALERTAS_SMTP_SSL=true
ALERTAS_SMTP_REMITENTE=cubicador@local
ALERTAS_SMTP_USUARIO=
ALERTAS_SMTP_CLAVE=
ALERTAS_EQUIPO_TECNICO=

# --- Vigilante de timeouts del worker (S3-HU-06.1, ver CONTRATO.md 6.4) -----
# Un plan que lleve mas de TIMEOUT minutos en 'procesando' se da por perdido:
# el worker publica cubicacion.rechazada (codigo TIMEOUT_PROCESAMIENTO) y lo
# marca 'error'. Subir el timeout si hay planes grandes que legitimamente
# tardan; bajar el intervalo acelera la deteccion a costa de mas consultas.
CUBICADOR_TIMEOUT_PROCESANDO_MINUTOS=5
CUBICADOR_INTERVALO_VIGILANTE_SEGUNDOS=60
