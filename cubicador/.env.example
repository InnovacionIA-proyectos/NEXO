# Copiar a .env (gitignored) y completar con valores reales.
# Ver DECISIONES_TECNICAS.md #7 (autenticacion) y #9 (RabbitMQ).

# --- Base de datos: SQL Server (S5-HU-17.1) --------------------------------
# El Cubicador YA NO tiene base propia: vive en el ESQUEMA `dbo_cubicador` de
# `dbTarifario_Nexo_Pruebas`, que COMPARTE CON COTIFLY (esquema `dbo_cotifly`).
# NEXO no esta ahi: tiene su propia base `Nexo`, esquema `db_NEXO`.
#
# DATABASE_URL se usa al correr FUERA de docker: pytest contra base real y
# scripts de verificacion. Dentro de docker-compose la arma el propio compose
# apuntando al contenedor `db` local, asi que ahi se ignora.
#
# Formato:
#   mssql+aioodbc://USUARIO:CLAVE@HOST:1433/dbTarifario_Nexo_Pruebas?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# OJO: si la clave trae @ : / # o ?, hay que codificarla (urllib.parse.
# quote_plus) o el DSN se parte mal. Es el error mas comun al cambiar de motor.
DATABASE_URL=

# Esquema donde viven TODAS las tablas del Cubicador. Se declara en el
# MetaData de SQLAlchemy. Sin esto las tablas caerian en `dbo`, que se
# comparte con Cotifly.
CUBICADOR_DB_ESQUEMA=dbo_cubicador

# --- Copia local de la base de NEXO (scripts/copia_local/) --------------
# Cadena del SQL Server CORPORATIVO, de donde se LEE para traer una copia de
# los datos de NEXO a la base local y poder probar contra datos reales sin
# tocar lo desplegado. Formato ADO.NET, el mismo de Dokploy:
#
#   Server=10.10.40.85,1433;Database=...;User Id=...;Password=...;
#
# Va aparte de DATABASE_URL a proposito: esa se apunta a la copia local para
# que la app trabaje contra ella, y reusarla aqui haria que los verificadores
# comparen la copia contra si misma y den todo por bueno. Pasa de verdad - el
# inventario dio 31 tablas en vez de 33 hasta que se separaron.
#
# Solo hace falta para correr esos scripts; la aplicacion no la lee.
COPIA_ORIGEN_CONNECTION=

# Clave del usuario `sa` del contenedor LOCAL de SQL Server (servicio `db` de
# docker-compose.yml). Solo para desarrollo y para el smoke test de CI: en QA
# y produccion no se usa, ahi se apunta a la base compartida con DATABASE_URL.
# SQL Server exige minimo 8 caracteres con mayuscula, minuscula, numero y
# simbolo, o el contenedor no arranca. Evita @ : / en esta clave local: el
# compose la mete en un DSN y tendrias que codificarla.
MSSQL_SA_PASSWORD=

# --- RabbitMQ (broker COMPARTIDO de NEXO, no un contenedor propio - ver
# DECISIONES_TECNICAS.md #9). Deben ser los MISMOS valores que RABBITMQ_USER/
# RABBITMQ_PASSWORD en el .env de la raiz de NEXO: es el mismo broker. ---
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# --- Autenticacion servicio-a-servicio (ver CONTRATO.md seccion 5) ---
# Valida las llamadas ENTRANTES a la API HTTP de este servicio (Authorization:
# Bearer <esto>). NEXO NO la usa (habla con este servicio solo por colas,
# nunca HTTP) - hoy solo la usan CI/scripts de verificacion manual. Rotar si
# queda expuesta (por ejemplo en el bundle publico de un portal que la
# llame directo).
CUBICADOR_API_KEY=

# --- Una llave POR SISTEMA (S5-HU-17.4) ---
# De aca sale el `origenSistema` VERIFICADO de POST /recomendaciones, en vez de
# creerle al cuerpo de la peticion: quien tiene la llave de Cotifly es Cotifly.
# La generica de arriba NO sirve para ese endpoint - identifica al servicio, no
# a un sistema - pero si para /api/planes-cargue y los catalogos.
#
# La de Cotifly la genera Cotifly; solo tiene que ser DISTINTA de la de NEXO.
# Dos variables y no un mapa en una sola cadena: se leen mejor en Dokploy y
# rotar una no obliga a tocar la otra.
CUBICADOR_API_KEY_NEXO=
CUBICADOR_API_KEY_COTIFLY=

# --- Modo sombra de la IA en el Cubicador (opcional, nace APAGADO) ---
# Con IA_SOMBRA_HABILITADA=true y una llave, cada POST /recomendaciones agenda una
# comparacion con Claude en segundo plano: la respuesta al usuario no cambia ni se
# retrasa, y la diferencia con el motor queda en la tabla dbo_cubicador.iaSombra
# (aplicar antes cubicador/database/esquema/367_ia_sombra.sql). Sin llave, o con el
# interruptor en false, no se llama a nadie y no se toca la red.
# La llave es PROPIA del Cubicador (su propia workspace de Anthropic con limite de
# gasto mensual); no se comparte con NEXO. Guia: docs/despliegue/ROTACION-LLAVE-ANTHROPIC.md
IA_SOMBRA_HABILITADA=false
ANTHROPIC_API_KEY=
# Solo si la llave es de organizacion y no de una workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=high
# Fraccion de recomendaciones que se comparan (0 a 1) y tope de tokens por dia (hora de Colombia; 0 = sin tope).
IA_SOMBRA_MUESTREO=1.0
IA_SOMBRA_TOPE_TOKENS_DIA=1000000
IA_SOMBRA_TIMEOUT_SEGUNDOS=60
IA_SOMBRA_MAX_CONCURRENTES=2
IA_SOMBRA_MAX_PENDIENTES=20
IA_SOMBRA_MAX_TOKENS_SALIDA=4096

# Se usa al llamar DE VUELTA a NEXO (puente Solicitudes -> Cubicador,
# crear_desde_linea) - debe ser IDENTICA a Cubicador3D__InboundApiKey en el
# .env de la raiz de NEXO.
NEXO_CALLBACK_API_KEY=

# --- Donde vive NEXO (para el endpoint de lineas de solicitud) ---
NEXO_BASE_URL=http://localhost:5080

# --- Puerto publicado al host para docker-compose (el contenedor sigue
# escuchando en 8000 puertas adentro). 8081 por defecto para no chocar con
# el 8080 donde corre el backend .NET; cambiar a 8082 si hace falta. ---
CUBICADOR_HOST_PORT=8081

# --- Alerta por correo al caer un mensaje en cubicacion.dlq (ver
# infrastructure/alertas/correo.py). Todas opcionales: sin ALERTAS_SMTP_HOST
# el worker sigue funcionando igual, solo deja de mandar el correo (log
# warning en su lugar). ALERTAS_EQUIPO_TECNICO vacio usa el default del
# codigo (el mismo equipo que ya recibe la alerta equivalente en NEXO). ---
ALERTAS_SMTP_HOST=
ALERTAS_SMTP_PUERTO=587
ALERTAS_SMTP_SSL=true
ALERTAS_SMTP_REMITENTE=cubicador@local
ALERTAS_SMTP_USUARIO=
ALERTAS_SMTP_CLAVE=
ALERTAS_EQUIPO_TECNICO=

# --- Vigilante de timeouts del worker (ver CONTRATO.md 6.4) -----------------
# Un plan que lleve mas de TIMEOUT minutos en 'procesando' se da por perdido:
# el worker publica cubicacion.rechazada (codigo TIMEOUT_PROCESAMIENTO) y lo
# marca 'error'. Subir el timeout si hay planes grandes que legitimamente
# tardan; bajar el intervalo acelera la deteccion a costa de mas consultas.
CUBICADOR_TIMEOUT_PROCESANDO_MINUTOS=5
CUBICADOR_INTERVALO_VIGILANTE_SEGUNDOS=60

# --- Variables que el codigo lee pero que NO van aca ------------------------
# Se listan para que no parezca que la plantilla esta incompleta.
#
# CUBICADOR_RABBITMQ_URL  La arma el propio docker-compose a partir de
#                         RABBITMQ_USER y RABBITMQ_PASSWORD de arriba. Solo
#                         hace falta definirla a mano si se corre la api o el
#                         worker FUERA de docker; sin ella cae a
#                         amqp://guest:guest@localhost:5672/, que solo
#                         funciona desde la propia maquina del broker.
#
# API_BASE_URL            Solo la lee scripts/ci_docker_smoke.py.
# CUBICADOR_URL           Solo la lee scripts/verificar_integracion_mssql.py.
#                         Las dos caen a http://localhost:8081, que es el
#                         puerto que publica el compose, asi que en local no
#                         hay que tocarlas.
