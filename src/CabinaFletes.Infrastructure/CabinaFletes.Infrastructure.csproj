<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capa Infrastructure (Adapters Out): EF Core, repositorios (implementan los puertos
    de Application), DW externos de solo lectura, SMTP, exportación a Excel.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CabinaFletes.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MassTransit FIJADO EN LA RAMA 8.x, y no por comodidad.

      La 8.5.10 es Apache-2.0. A partir de la 9.0.0 el proyecto se movió a
      massient.com con licencia comercial (el paquete ya no declara expresión SPDX,
      solo un licenseUrl propio). Subir de mayor obligaría a una decisión de compra.

      Es el mismo criterio por el que este backend implementa su propio CQRS en vez
      de usar MediatR. Verificado contra los metadatos del paquete en nuget.org.

      Si alguien necesita subir de la 8.x, que sea una decisión consciente y no un
      "actualizar dependencias".
    -->
    <PackageReference Include="MassTransit" Version="8.5.10" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
    <!-- RabbitMQ.Client directo (no vía MassTransit) para el puente con Cubicador -
         ver Cubicacion/CubicacionRabbitAdapter.cs. Version igual a la que ya resuelve
         MassTransit.RabbitMQ 8.5.10 transitivamente, para no duplicar versiones. -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CabinaFletes.Domain\CabinaFletes.Domain.csproj" />
    <ProjectReference Include="..\CabinaFletes.Application\CabinaFletes.Application.csproj" />
  </ItemGroup>

</Project>
