# =============================================================================
# Variables de entorno para desplegar NEXO en Dokploy — CADA BLOQUE es una app
# "Application" (Dockerfile) DISTINTA en Dokploy, no un docker-compose.
# =============================================================================
# IMPORTANTE — por qué este archivo cambió de formato (2026-09-21):
#
# La version anterior de este archivo traia los nombres "amigables" que usan
# los docker-compose.yml del repo (ORIGENES_PERMITIDOS_CORS, SCORE_INTERVALO_
# MINUTOS, etc.). Esos nombres SOLO funcionan si Dokploy corre el stack como
# "Docker Compose", porque es el propio docker-compose.yml el que traduce cada
# uno a la variable real que lee la app (ej. Cors__OrigenesPermitidos) y arma
# las URLs compuestas (ConnectionStrings__RabbitMq, DATABASE_URL) a partir de
# piezas sueltas (RABBITMQ_USER/PASSWORD, MSSQL_SA_PASSWORD).
#
# Como el despliegue real va a ser con "Dockerfile" (una app de Dokploy por
# Dockerfile, sin compose de por medio), NADIE arma esa traduccion por ti:
# lo que pongas en la pestaña Environment de cada app en Dokploy es EXACTAMENTE
# el nombre de variable que el proceso dentro del contenedor va a leer. Por
# eso este archivo ahora tiene el nombre final y real de cada variable,
# agrupado por app de Dokploy — no por "stack" del repo.
#
# Dos variables aqui NO estaban en la version anterior y son bloqueantes en
# Produccion (la app no arranca sin ellas, ver clsProgram.cs / clsEsquemaNexo.cs):
#   - ConnectionStrings__RabbitMq (antes la armaba docker-compose.yml solo)
#   - Database__Esquema           (antes la armaba docker-compose.yml solo)
#
# NUNCA subir este archivo con valores reales rellenados — es solo la plantilla.
# =============================================================================


# =============================================================================
# App Dokploy: "nexo-rabbit"   (Dockerfile: build/Dockerfile.rabbit)
# =============================================================================
# Nombres EXACTOS que exige la imagen oficial de RabbitMQ (no son invento del
# repo): RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS, no RABBITMQ_USER/
# RABBITMQ_PASSWORD como decia la version anterior de este archivo — esos
# nombres solo existian como variables de ENTRADA para el docker-compose.yml
# raiz, que los traducia el mismo compose.

RABBITMQ_DEFAULT_USER=nexo
RABBITMQ_DEFAULT_PASS=<clave-fuerte-rabbitmq>

# Puertos (5672 AMQP interno, 15672 consola): se configuran en la pestaña de
# puertos/dominios de esta app en Dokploy, no como variables de entorno.


# =============================================================================
# App Dokploy: "nexo-api"   (Dockerfile: src/Nexo.Api/Dockerfile)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Production

# BD principal de Nexo (SQL Server). Unico dato dinamico: nunca hardcodeado.
ConnectionStrings__Nexo=Server=<host>;Database=Nexo;User Id=<usuario>;Password=<clave>;Encrypt=True;TrustServerCertificate=True;

# Esquema propio de NEXO dentro de esa base (ver clsEsquemaNexo.cs). Fail-closed
# SIN default en el codigo: si falta, la app no arranca. NO era parte de la
# version anterior de este archivo.
Database__Esquema=db_NEXO

# Broker de mensajeria. Fail-closed en Produccion (ver clsProgram.cs): sin
# esto la app ni siquiera intenta usar RabbitMq, tira InvalidOperationException
# al arrancar. <host-nexo-rabbit-en-dokploy> = el hostname interno que Dokploy
# le asigna a la app "nexo-rabbit" de arriba (revisar en su pestaña Domains/
# Advanced de esa app en Dokploy — Dokploy pone todas las apps del mismo
# proyecto en la red interna "dokploy-network" y se alcanzan por su nombre de
# servicio ahi, pero el nombre exacto lo asigna Dokploy, no este repo).
ConnectionStrings__RabbitMq=amqp://nexo:<misma-clave-que-RABBITMQ_DEFAULT_PASS-de-arriba>@<host-nexo-rabbit-en-dokploy>:5672/

# Identidad del portal de la Administracion (solo lectura). Fail-closed en
# Produccion (ver clsProgram.cs): sin esto la Api no arranca.
ConnectionStrings__IdentidadPortal=Server=<host>;Database=<base-identidad-portal>;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=True;TrustServerCertificate=True;

# Data Warehouse corporativo (opcionales: si faltan, el modulo que las usa se
# degrada solo — 503 accionable o adapter local, nunca rompe el arranque).
ConnectionStrings__DwSice=Server=<host>,1433;Database=DWSice;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
ConnectionStrings__DbSolucionesTi=Server=<host>;Database=dbsolucionesTI;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
ConnectionStrings__DwCubos=Server=<host>,1433;Database=DWCubosOperacionesEBS;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;

# Migraciones: no se usan en este proyecto — el esquema se crea/actualiza corriendo
# docs/Database/ESQUEMA_NEXO.sql a mano contra la base nueva. Dejar siempre en false.
# Seed: SIEMPRE false en Produccion (clsDataSeeder.cs es 100% datos ficticios de
# demo, nunca debe tocar produccion).
Database__MigrateOnStartup=false
Database__SeedOnStartup=false

# Fail-closed en Produccion (ver clsProgram.cs): sin esto la Api no arranca.
Cors__OrigenesPermitidos=https://<dominio-portal-produccion>

# Recalculo de score de priorizacion.
Score__IntervaloRecalculoMinutos=15
Score__TamanoDeLoteRecalculo=200

# Conexion SAP plaza en vivo: Deshabilitado | Mock | Real.
SapTarifaFleteEnVivo__Modo=Deshabilitado

# Compuerta de liberacion del plan de cargue por paridad (vacias = en
# verificacion, responde 503 sin fallback).
Cubicacion__ParidadVerificada=
Cubicacion__ParidadEvidencia=
Cubicacion__ParidadFecha=

# Puente NEXO <-> Cubicador3D. InboundApiKey debe ser igual a
# NEXO_CALLBACK_API_KEY de las apps "cubicador-api"/"cubicador-worker" de
# abajo; OutboundApiKey debe ser igual a CUBICADOR_API_KEY de "cubicador-api".
# <host-cubicador-api-en-dokploy> = hostname interno de la app "cubicador-api"
# (mismo criterio que <host-nexo-rabbit-en-dokploy> de arriba).
Cubicador3D__InboundApiKey=<secreto-compartido>
Cubicador3D__OutboundBaseUrl=http://<host-cubicador-api-en-dokploy>:8000
Cubicador3D__OutboundApiKey=<secreto-compartido>

# SMTP corporativo (opcional; sin Host/Remitente no se envia correo).
Smtp__Host=smtp.boterosoto.com.co
Smtp__Puerto=587
Smtp__Ssl=true
Smtp__Remitente=<remitente@dominio>
Smtp__Usuario=
Smtp__Clave=

# Microservicio MailSender (opcional).
MailSender__BaseUrl=
MailSender__Remitente=
MailSender__TimeoutSegundos=30


# =============================================================================
# App Dokploy: "cubicador-db"   — SE RETIRA (S5-HU-17.1)
# =============================================================================
# El Cubicador dejo de tener base propia: ya no hay contenedor Postgres que
# desplegar. Ahora vive en el ESQUEMA `dbo_cubicador` de la base COMPARTIDA
# `dbTarifario_Nexo_Pruebas` del SQL Server corporativo, que COMPARTE CON
# COTIFLY (esquema `dbo_cotifly`). NEXO no esta ahi: usa su propia base
# `Nexo` con esquema `db_NEXO`.
#
# Al retirar la app en Dokploy hay que borrar tambien su volumen: ahi quedan
# los planes de cargue viejos. Migrarlos ANTES (los datos se migran, no se
# arranca vacio) y correr despues cubicador/docs/seeder/
# corregir_vehiculos_existentes.sql, que arregla las 5 filas de vehiculos con
# medidas inventadas — la siembra por nombre nunca las actualiza sola.
#
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD ya no se usan en ningun lado.


# =============================================================================
# App Dokploy: "cubicador-api"   (Dockerfile: cubicador/Dockerfile)
# =============================================================================
# Python: os.environ.get(...) directo (ver cubicador/api/dependencias.py,
# cubicador/infrastructure/persistence/db.py) — SIN fail-closed ni validacion
# de arranque. OJO: si se te olvida definir DATABASE_URL o
# CUBICADOR_RABBITMQ_URL, el proceso NO truena — arranca calladamente contra
# un SQLite local del contenedor (se pierde con cada redeploy) o intenta
# amqp://guest:guest@localhost:5672/ (nunca va a conectar). Verificar SIEMPRE
# con /health y logs tras el primer despliegue, no asumir que "no truena" =
# "quedo bien configurado".

# Base compartida del SQL Server corporativo: esquema `dbo_cubicador` dentro
# de `dbTarifario_Nexo_Pruebas`. El usuario necesita permisos DDL — alembic
# crea y altera tablas; uno de solo lectura/escritura de datos no alcanza.
# Si la clave trae @ : / # o ?, hay que codificarla en la URL o el DSN se
# parte mal.
DATABASE_URL=mssql+aioodbc://<usuario>:<clave-codificada>@<host-sqlserver>:1433/dbTarifario_Nexo_Pruebas?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Esquema de TODAS las tablas del Cubicador. Sin esto caerian en `dbo`, que se
# comparte con Cotifly.
CUBICADOR_DB_ESQUEMA=dbo_cubicador

# Bearer que valida llamadas ENTRANTES de NEXO al Cubicador. Debe ser igual a
# Cubicador3D__OutboundApiKey de "nexo-api".
CUBICADOR_API_KEY=<secreto-compartido-con-Cubicador3D__OutboundApiKey>

# Una llave POR SISTEMA (S5-HU-17.4). De aca sale el `origenSistema`
# VERIFICADO de POST /recomendaciones: quien tiene la llave de Cotifly es
# Cotifly. La generica de arriba NO sirve para ese endpoint.
# La de Cotifly la genera Cotifly y solo tiene que ser DISTINTA de la de NEXO.
CUBICADOR_API_KEY_NEXO=<secreto-para-NEXO>
CUBICADOR_API_KEY_COTIFLY=<secreto-que-entrega-Cotifly>

# Mismas credenciales que RABBITMQ_DEFAULT_USER/PASS de "nexo-rabbit".
CUBICADOR_RABBITMQ_URL=amqp://nexo:<misma-clave-que-RABBITMQ_DEFAULT_PASS>@<host-nexo-rabbit-en-dokploy>:5672/

# Base URL de NEXO y bearer que Cubicador usa al llamar de vuelta (crear plan
# desde linea). El bearer debe ser igual a Cubicador3D__InboundApiKey de
# "nexo-api".
NEXO_BASE_URL=http://<host-nexo-api-en-dokploy>:8080
NEXO_CALLBACK_API_KEY=<secreto-compartido-con-Cubicador3D__InboundApiKey>


# =============================================================================
# App Dokploy: "cubicador-worker"   (Dockerfile: cubicador/Dockerfile.worker)
# =============================================================================
# Mismos valores que "cubicador-api" de arriba (DB y broker compartidos):
# Base compartida del SQL Server corporativo: esquema `dbo_cubicador` dentro
# de `dbTarifario_Nexo_Pruebas`. El usuario necesita permisos DDL — alembic
# crea y altera tablas; uno de solo lectura/escritura de datos no alcanza.
# Si la clave trae @ : / # o ?, hay que codificarla en la URL o el DSN se
# parte mal.
DATABASE_URL=mssql+aioodbc://<usuario>:<clave-codificada>@<host-sqlserver>:1433/dbTarifario_Nexo_Pruebas?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Esquema de TODAS las tablas del Cubicador, incluida `alembic_version`. Sin
# esto caerian en `dbo`, que se comparte con Cotifly.
CUBICADOR_DB_ESQUEMA=dbo_cubicador
CUBICADOR_RABBITMQ_URL=amqp://nexo:<misma-clave-que-RABBITMQ_DEFAULT_PASS>@<host-nexo-rabbit-en-dokploy>:5672/
NEXO_BASE_URL=http://<host-nexo-api-en-dokploy>:8080
NEXO_CALLBACK_API_KEY=<secreto-compartido-con-Cubicador3D__InboundApiKey>

# Vigilante de timeouts (solo el worker lo corre, la api no).
CUBICADOR_TIMEOUT_PROCESANDO_MINUTOS=5
CUBICADOR_INTERVALO_VIGILANTE_SEGUNDOS=60

# Alerta por correo si un mensaje cae a la cola de error (opcional).
ALERTAS_SMTP_HOST=
ALERTAS_SMTP_PUERTO=587
ALERTAS_SMTP_SSL=true
ALERTAS_SMTP_REMITENTE=cubicador@local
ALERTAS_SMTP_USUARIO=
ALERTAS_SMTP_CLAVE=
ALERTAS_EQUIPO_TECNICO=
