# Variables de NEXO para Dokploy. Cada bloque es una app "Application" (Dockerfile) distinta, no un docker-compose:
# los nombres son los reales que lee el proceso dentro del contenedor (no los alias de docker-compose.yml).
# Es una plantilla: nunca subas valores reales.

# =============================================================================
# App "nexo-rabbit"  (build/Dockerfile.rabbit)
# =============================================================================
# Nombres exigidos por la imagen oficial de RabbitMQ. Los puertos (5672 AMQP, 15672 consola) se configuran en la pestaña de puertos/dominios.
RABBITMQ_DEFAULT_USER=nexo
RABBITMQ_DEFAULT_PASS=<clave-fuerte-rabbitmq>

# =============================================================================
# App "nexo-api"  (src/Nexo.Api/Dockerfile)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Production
# BD principal de NEXO (SQL Server).
ConnectionStrings__Nexo=Server=<host>;Database=Nexo;User Id=<usuario>;Password=<clave>;Encrypt=True;TrustServerCertificate=True;
# Esquema de NEXO en esa base. Obligatoria: sin ella la app no arranca.
Database__Esquema=db_NEXO
# Broker de mensajería. Obligatoria en Production. El host es el nombre interno que Dokploy asigna a la app "nexo-rabbit" (ver su pestaña Domains/Advanced).
ConnectionStrings__RabbitMq=amqp://nexo:<misma-clave-que-RABBITMQ_DEFAULT_PASS-de-arriba>@<host-nexo-rabbit-en-dokploy>:5672/
# Identidad del portal (solo lectura). Obligatoria en Production.
ConnectionStrings__IdentidadPortal=Server=<host>;Database=<base-identidad-portal>;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=True;TrustServerCertificate=True;
# Data Warehouse corporativo (opcionales: si faltan, el módulo que las usa se degrada).
ConnectionStrings__DwSice=Server=<host>,1433;Database=DWSice;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
ConnectionStrings__DbSolucionesTi=Server=<host>;Database=dbsolucionesTI;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
ConnectionStrings__DwCubos=Server=<host>,1433;Database=DWCubosOperacionesEBS;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
# Sin migraciones: el esquema se crea con database/esquema/ESQUEMA_NEXO.sql. MigrateOnStartup siempre false; SeedOnStartup siempre false en Production
# (el seeder carga datos ficticios de demo).
Database__MigrateOnStartup=false
Database__SeedOnStartup=false
# Obligatoria en Production.
Cors__OrigenesPermitidos=https://<dominio-portal-produccion>
# Recálculo del score de priorización.
Score__IntervaloRecalculoMinutos=15
Score__TamanoDeLoteRecalculo=200
# Plaza SAP en vivo: Deshabilitado | Mock | Real.
SapTarifaFleteEnVivo__Modo=Deshabilitado
# Compuerta de paridad del plan de cargue (vacías = en verificación, responde 503).
Cubicacion__ParidadVerificada=
Cubicacion__ParidadEvidencia=
Cubicacion__ParidadFecha=
# Puente con el Cubicador. InboundApiKey = NEXO_CALLBACK_API_KEY de "cubicador-api"/"cubicador-worker"; OutboundApiKey = CUBICADOR_API_KEY de "cubicador-api".
# El host de OutboundBaseUrl es el nombre interno de la app "cubicador-api" en Dokploy.
Cubicador3D__InboundApiKey=<secreto-compartido>
Cubicador3D__OutboundBaseUrl=http://<host-cubicador-api-en-dokploy>:8000
Cubicador3D__OutboundApiKey=<secreto-compartido>
# SMTP corporativo (opcional; sin Host/Remitente no se envía correo).
Smtp__Host=smtp.boterosoto.com.co
Smtp__Puerto=587
Smtp__Ssl=true
Smtp__Remitente=<remitente@dominio>
Smtp__Usuario=
Smtp__Clave=
# Microservicio MailSender (opcional).
MailSender__BaseUrl=
MailSender__Remitente=
MailSender__TimeoutSegundos=30
# Modelo de lenguaje (Anthropic), opcional. Sin ApiKey la IA responde 503 (IA_NO_CONFIGURADA). La llave se escribe solo en la pestaña Environment de Dokploy.
# Cada función se enciende por separado. Rotación y verificación: docs/despliegue/ROTACION-LLAVE-ANTHROPIC.md
Anthropic__ApiKey=<secreto>
Anthropic__Habilitada=true
Anthropic__LimiteTokensPorUsuarioDia=500000
Anthropic__WorkspaceId=
Anthropic__Model=claude-sonnet-5-5
Anthropic__Effort=high
Anthropic__Funciones__ImportacionExcel=false
Anthropic__Funciones__AsistenteCotizacion=false
Anthropic__Funciones__ApoyoCubicador=false

# =============================================================================
# App "cubicador-db"  — RETIRADA
# =============================================================================
# El Cubicador ya no tiene Postgres propio: usa el esquema `dbo_cubicador` de la base compartida `dbTarifario_Nexo_Pruebas` (SQL Server corporativo,
# compartida con Cotifly en `dbo_cotifly`). Al retirar la app borra también su volumen, pero migra antes los planes de cargue viejos.
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD ya no se usan.

# =============================================================================
# App "cubicador-api"  (cubicador/Dockerfile)
# =============================================================================
# Python lee las variables sin validar el arranque: si falta DATABASE_URL o CUBICADOR_RABBITMQ_URL el proceso no falla, arranca contra un SQLite local
# (se pierde en cada redeploy) o contra amqp://guest@localhost. Verifica siempre con /health y los logs tras el primer despliegue.

# Esquema `dbo_cubicador` de la base compartida (QA actual; la base propia dbCubicador_Pruebas.dbo queda para la #423). La app solo lee y escribe datos: el esquema lo aplica una persona con cubicador/database/esquema/ESQUEMA_CUBICADOR.sql (no hay alembic).
# Si la clave trae @ : / # o ?, codifícala en la URL.
DATABASE_URL=mssql+aioodbc://<usuario>:<clave-codificada>@<host-sqlserver>:1433/dbTarifario_Nexo_Pruebas?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Esquema de todas las tablas del Cubicador; sin esto caerían en `dbo`, compartido con Cotifly.
CUBICADOR_DB_ESQUEMA=dbo_cubicador
# Bearer de las llamadas ENTRANTES de NEXO. Igual a Cubicador3D__OutboundApiKey de "nexo-api".
CUBICADOR_API_KEY=<secreto-compartido-con-Cubicador3D__OutboundApiKey>
# Una llave por sistema: de ella sale el origenSistema verificado de POST /recomendaciones. La genérica no sirve para ese endpoint.
# La de Cotifly la genera Cotifly y debe ser distinta de la de NEXO.
CUBICADOR_API_KEY_NEXO=<secreto-para-NEXO>
CUBICADOR_API_KEY_COTIFLY=<secreto-que-entrega-Cotifly>
# Mismas credenciales que RABBITMQ_DEFAULT_USER/PASS de "nexo-rabbit".
CUBICADOR_RABBITMQ_URL=amqp://nexo:<misma-clave-que-RABBITMQ_DEFAULT_PASS>@<host-nexo-rabbit-en-dokploy>:5672/
# URL de NEXO y Bearer con el que el Cubicador llama de vuelta (crear plan desde línea). El Bearer es igual a Cubicador3D__InboundApiKey de "nexo-api".
NEXO_BASE_URL=http://<host-nexo-api-en-dokploy>:8080
NEXO_CALLBACK_API_KEY=<secreto-compartido-con-Cubicador3D__InboundApiKey>

# =============================================================================
# App "cubicador-worker"  (cubicador/Dockerfile.worker)
# =============================================================================
# Mismos valores que "cubicador-api" (base y broker compartidos).
DATABASE_URL=mssql+aioodbc://<usuario>:<clave-codificada>@<host-sqlserver>:1433/dbTarifario_Nexo_Pruebas?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
CUBICADOR_DB_ESQUEMA=dbo_cubicador
CUBICADOR_RABBITMQ_URL=amqp://nexo:<misma-clave-que-RABBITMQ_DEFAULT_PASS>@<host-nexo-rabbit-en-dokploy>:5672/
NEXO_BASE_URL=http://<host-nexo-api-en-dokploy>:8080
NEXO_CALLBACK_API_KEY=<secreto-compartido-con-Cubicador3D__InboundApiKey>
# Vigilante de timeouts (solo lo corre el worker).
CUBICADOR_TIMEOUT_PROCESANDO_MINUTOS=5
CUBICADOR_INTERVALO_VIGILANTE_SEGUNDOS=60
# Alerta por correo si un mensaje cae a la cola de error (opcional).
ALERTAS_SMTP_HOST=
ALERTAS_SMTP_PUERTO=587
ALERTAS_SMTP_SSL=true
ALERTAS_SMTP_REMITENTE=cubicador@local
ALERTAS_SMTP_USUARIO=
ALERTAS_SMTP_CLAVE=
ALERTAS_EQUIPO_TECNICO=
