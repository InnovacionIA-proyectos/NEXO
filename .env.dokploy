# =============================================================================
# Variables de entorno para desplegar NEXO en Dokploy (build por Dockerfile).
# Cubre los dos stacks del repo: src/ (backend .NET + RabbitMQ) y cubicador/
# (api + worker + Postgres). Copiar estos valores a la seccion Environment de
# cada aplicacion en Dokploy (no se sube este archivo con secretos reales).
# =============================================================================

# --- RabbitMQ (compartido por backend .NET y Cubicador) --------------------
RABBITMQ_USER=nexo
RABBITMQ_PASSWORD=<clave-fuerte>
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# =============================================================================
# src/ — backend .NET (servicio "api" del docker-compose.yml raiz)
# =============================================================================
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# BD principal de Nexo (SQL Server). Unico dato dinamico: nunca hardcodeado.
ConnectionStrings__Nexo=Server=<host>;Database=Nexo;User Id=<usuario>;Password=<clave>;Encrypt=True;TrustServerCertificate=True;

# Identidad del portal de la Administracion (solo lectura). Vacia en
# Produccion = la Api no arranca (fail-closed, ver clsProgram.cs).
ConnectionStrings__IdentidadPortal=Server=<host>;Database=<base-identidad-portal>;User Id=<usuario-solo-lectura>;Password=<clave>;Encrypt=True;TrustServerCertificate=True;

# Data Warehouse corporativo (opcionales: si faltan, el modulo que las usa se degrada solo).
ConnectionStrings__DwSice=Server=<host>,1433;Database=DWSice;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
ConnectionStrings__DbSolucionesTi=Server=<host>;Database=dbsolucionesTI;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;
ConnectionStrings__DwCubos=Server=<host>,1433;Database=DWCubosOperacionesEBS;User Id=<usuario>;Password=<clave>;Encrypt=False;TrustServerCertificate=True;

MIGRATE_ON_STARTUP=false
SEED_ON_STARTUP=false
ORIGENES_PERMITIDOS_CORS=https://<dominio-portal-produccion>

# Recalculo de score de priorizacion.
SCORE_INTERVALO_MINUTOS=15
SCORE_TAMANO_LOTE=200

# Conexion SAP plaza en vivo: Deshabilitado | Mock | Real.
SAP_TARIFA_FLETE_EN_VIVO_MODO=Deshabilitado

# Compuerta de liberacion del plan de cargue por paridad (vacias = en verificacion).
CUBICACION_PARIDAD_VERIFICADA=
CUBICACION_PARIDAD_EVIDENCIA=
CUBICACION_PARIDAD_FECHA=

# Puente NEXO <-> Cubicador3D. InboundApiKey debe ser igual a NEXO_CALLBACK_API_KEY
# de abajo; OutboundApiKey debe ser igual a CUBICADOR_API_KEY de abajo.
CUBICADOR3D_INBOUND_API_KEY=<secreto-compartido>
CUBICADOR3D_OUTBOUND_BASE_URL=http://<host-o-alias-cubicador>:8000
CUBICADOR3D_OUTBOUND_API_KEY=<secreto-compartido>

# SMTP corporativo (opcional; sin Host/Remitente no se envia correo).
Smtp__Host=smtp.boterosoto.com.co
Smtp__Puerto=587
Smtp__Ssl=true
Smtp__Remitente=<remitente@dominio>
Smtp__Usuario=
Smtp__Clave=

# Microservicio MailSender (opcional).
MAILSENDER_BASE_URL=
MAILSENDER_REMITENTE=
MAILSENDER_TIMEOUT_SEGUNDOS=30

# =============================================================================
# cubicador/ — api + worker + Postgres propio
# =============================================================================
POSTGRES_PASSWORD=<clave-fuerte-postgres>
CUBICADOR_HOST_PORT=8081

# Bearer que valida llamadas ENTRANTES de NEXO al Cubicador.
CUBICADOR_API_KEY=<secreto-compartido-con-CUBICADOR3D_OUTBOUND_API_KEY>

# Base URL de NEXO y bearer que Cubicador usa al llamar de vuelta (crear plan
# desde linea). Debe ser igual a CUBICADOR3D_INBOUND_API_KEY de arriba.
NEXO_BASE_URL=http://<host-o-alias-nexo-api>:8080
NEXO_CALLBACK_API_KEY=<secreto-compartido-con-CUBICADOR3D_INBOUND_API_KEY>

CUBICADOR_TIMEOUT_PROCESANDO_MINUTOS=5
CUBICADOR_INTERVALO_VIGILANTE_SEGUNDOS=60

# Alerta por correo si un mensaje cae a la cola de error (opcional).
ALERTAS_SMTP_HOST=
ALERTAS_SMTP_PUERTO=587
ALERTAS_SMTP_SSL=true
ALERTAS_SMTP_REMITENTE=cubicador@local
ALERTAS_SMTP_USUARIO=
ALERTAS_SMTP_CLAVE=
ALERTAS_EQUIPO_TECNICO=
