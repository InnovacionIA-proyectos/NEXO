# Secrets de GitHub Actions que necesitan los pipelines de .github/workflows/ (ci-cd-api, ci-cd-cubicador-api, ci-cd-cubicador-worker, ci-cd-rabbitmq
# y add-to-project-nexo). No es un .env que la app lea: cada línea es <SECRET>=<de dónde sale el valor> (Settings > Secrets and variables > Actions).
# Los nombres deben coincidir con los workflows; si un workflow agrega un secret, agrégalo aquí. Nunca subas valores reales.

# --- Automatización del repositorio ---
# PAT con permiso de Projects para agregar issues y PRs al tablero (no sirve el GITHUB_TOKEN automático).
ADD_TO_PROJECT_PAT=<PAT classic con scope "project", generado desde la cuenta que administra el Project>

# --- CI del API (.NET) — ci-cd-api.yml ---
# Corre en un runner self-hosted: las BD son reales de la red corporativa. TEST_DB_CONNECTION es la BD de pruebas (nunca un contenedor efímero)
# y la suite completa corre contra ella.
TEST_DB_CONNECTION=<mismo valor que ConnectionStrings__Nexo en el .env del runner self-hosted>
# Las cuatro siguientes son de solo lectura y opcionales: sin ellas las pruebas ejercitan el camino degradado, no la fuente real.
CONNECTIONSTRINGS_DWSICE=<cadena de conexión a DWSice, solo lectura>
CONNECTIONSTRINGS_DBSOLUCIONESTI=<cadena de conexión a dbsolucionesTI, solo lectura>
CONNECTIONSTRINGS_DWCUBOS=<cadena de conexión a DWCubosOperacionesEBS, solo lectura>
CONNECTIONSTRINGS_IDENTIDADPORTAL=<cadena de conexión a la BD de identidad del portal, solo lectura>

# --- Despliegue (Dokploy) ---
# Webhook de cada servicio (Dokploy > servicio > Deployments > Webhook). Se dispara solo en push directo a main o DEPLOY, y tras pasar el build.
DOKPLOY_DEPLOY_WEBHOOK_URL_API=<URL del webhook de despliegue del servicio API en Dokploy>
DOKPLOY_DEPLOY_WEBHOOK_URL_CUBICADOR_API=<URL del webhook de despliegue del servicio Cubicador API en Dokploy>
DOKPLOY_DEPLOY_WEBHOOK_URL_CUBICADOR_WORKER=<URL del webhook de despliegue del servicio Cubicador Worker en Dokploy>
DOKPLOY_DEPLOY_WEBHOOK_URL_RABBITMQ=<URL del webhook de despliegue del servicio RabbitMQ en Dokploy>

# --- Verificación post-despliegue ---
# Sin uso por ahora: ningún workflow activo verifica /health tras el despliegue (el paso se retiró). El worker del Cubicador no tiene health check: se verifica por logs (ver DOKPLOY.md).
HEALTH_CHECK_URL_API=<URL base del servicio API en Dokploy, ej. https://nexo-api.dominio.com>
HEALTH_CHECK_URL_CUBICADOR_API=<URL base del servicio Cubicador API en Dokploy>

# --- Smoke test de RabbitMQ (scripts/rabbitmq_smoke.py) ---
# Sin uso por ahora: el job del smoke test se retiró del workflow (el script sigue disponible para correrlo a mano). Consola de administración (15672) del RabbitMQ desplegado; mismos valores que RABBITMQ_USER/RABBITMQ_PASSWORD de producción.
RABBITMQ_MGMT_URL=<URL de la consola de administración de RabbitMQ, ej. http://host-interno:15672>
RABBITMQ_USER=<mismo valor que RABBITMQ_USER en el .env de producción>
RABBITMQ_PASSWORD=<mismo valor que RABBITMQ_PASSWORD en el .env de producción>

# Las variables de runtime de cada servicio no son GitHub Secrets: van en el Environment de cada app en Dokploy (ver .env.dokploy).
