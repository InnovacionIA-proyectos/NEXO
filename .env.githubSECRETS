# =============================================================================
# Secrets requeridos en GitHub para las pipelines de CI/CD de NEXO
# =============================================================================
# Esto NO es un archivo .env que la app lea — es una referencia de qué crear en
# GitHub (Settings -> Secrets and variables -> Actions -> New repository
# secret) para que las 4 pipelines de .github/workflows/ (ci-cd-api.yml,
# ci-cd-cubicador-api.yml, ci-cd-cubicador-worker.yml, ci-cd-rabbitmq.yml) y
# add-to-project-nexo.yml funcionen en push/PR contra "main" y "DEPLOY".
#
# NUNCA subir este archivo con valores reales rellenados. Cada línea de abajo
# es <NOMBRE_DEL_SECRET>=<de dónde sale el valor>, no el valor mismo.
#
# Los nombres de la izquierda son EXACTOS (deben coincidir letra por letra con
# los workflows) — verificado el 2026-09-21 contra secrets.* en los 4 workflows
# + add-to-project-nexo.yml. Si se agrega un secret nuevo a algún workflow,
# agréguelo también aquí.
# =============================================================================


# -----------------------------------------------------------------------------
# Automatización de repo (no es específico de despliegue)
# -----------------------------------------------------------------------------

# Personal Access Token (classic o fine-grained con permiso de "Projects") de
# una cuenta con acceso al Project de GitHub del equipo. Usado por
# add-to-project-nexo.yml para agregar issues/PRs nuevos al tablero
# automáticamente. NO es el GITHUB_TOKEN automático de Actions (ese no tiene
# permiso sobre Projects).
ADD_TO_PROJECT_PAT=<PAT classic con scope "project", generado desde la cuenta que administra el Project>


# -----------------------------------------------------------------------------
# CI del servicio API (.NET) — ci-cd-api.yml, job build-and-test
# -----------------------------------------------------------------------------
# Corren en un runner self-hosted (dokploy_) porque estas 5 conexiones son BD
# reales de la red corporativa privada — un runner en la nube de GitHub jamás
# podría alcanzarlas.

# Cadena de conexión a dbInformesAutomatizados_Pruebas (la BD de pruebas REAL,
# NUNCA un contenedor efímero) — mismo valor que ConnectionStrings__Nexo en el
# .env del runner self-hosted. La suite completa (dotnet test) corre contra
# esto en cada push/PR a main o DEPLOY.
TEST_DB_CONNECTION=<mismo valor que ConnectionStrings__Nexo en el .env del runner self-hosted>

# Las siguientes 4 son SOLO LECTURA y OPCIONALES para que la app arranque (si
# faltan, Infrastructure/clsDependencyInjection.cs degrada solo: 503 accionable
# o adapter local, nunca falla la DI) — pero sin definirlas aquí, las pruebas
# que dependen de ellas pasan ejercitando el camino degradado, no la fuente
# real. Mismo nombre de variable que lee IConfiguration (doble guion bajo:
# ASP.NET Core las mapea solo, cero cambio de código).
CONNECTIONSTRINGS_DWSICE=<cadena de conexión a DWSice, solo lectura>
CONNECTIONSTRINGS_DBSOLUCIONESTI=<cadena de conexión a dbsolucionesTI, solo lectura>
CONNECTIONSTRINGS_DWCUBOS=<cadena de conexión a DWCubosOperacionesEBS, solo lectura>
CONNECTIONSTRINGS_IDENTIDADPORTAL=<cadena de conexión a la BD de identidad del portal, solo lectura>


# -----------------------------------------------------------------------------
# Despliegue (Dokploy) — jobs "deploy" de las 4 pipelines
# -----------------------------------------------------------------------------
# Cada servicio de Dokploy expone su propia URL de webhook (Dokploy -> el
# servicio -> Deployments -> Webhook). Se disparan solo en push directo a main
# o DEPLOY (nunca en PRs), y solo si el job de build-and-test/build pasó antes.

DOKPLOY_DEPLOY_WEBHOOK_URL_API=<URL del webhook de despliegue del servicio API en Dokploy>
DOKPLOY_DEPLOY_WEBHOOK_URL_CUBICADOR_API=<URL del webhook de despliegue del servicio Cubicador API en Dokploy>
DOKPLOY_DEPLOY_WEBHOOK_URL_CUBICADOR_WORKER=<URL del webhook de despliegue del servicio Cubicador Worker en Dokploy>
DOKPLOY_DEPLOY_WEBHOOK_URL_RABBITMQ=<URL del webhook de despliegue del servicio RabbitMQ en Dokploy>


# -----------------------------------------------------------------------------
# Verificación post-despliegue (health checks)
# -----------------------------------------------------------------------------
# URL base pública (o interna, alcanzable desde el runner self-hosted) de cada
# servicio con endpoint HTTP — el workflow le agrega "/health" solo. El worker
# de Cubicador NO tiene health check acá a propósito: es un servicio de
# background sin puerto HTTP (ver DOKPLOY.md), se verifica por logs, no por URL.

HEALTH_CHECK_URL_API=<URL base del servicio API en Dokploy, ej. https://nexo-api.dominio.com>
HEALTH_CHECK_URL_CUBICADOR_API=<URL base del servicio Cubicador API en Dokploy>


# -----------------------------------------------------------------------------
# Smoke test post-despliegue de RabbitMQ — ci-cd-rabbitmq.yml, job
# smoke-test-post-deploy (scripts/rabbitmq_smoke.py)
# -----------------------------------------------------------------------------
# Credenciales y URL de la consola de administración (Management UI, puerto
# 15672) del RabbitMQ YA desplegado — no expuesta al público, solo alcanzable
# desde el runner self-hosted. MISMOS valores que RABBITMQ_USER/
# RABBITMQ_PASSWORD en el .env de producción (Dokploy) — no una cuenta aparte.

RABBITMQ_MGMT_URL=<URL de la consola de administración de RabbitMQ, ej. http://host-interno:15672>
RABBITMQ_USER=<mismo valor que RABBITMQ_USER en el .env de producción>
RABBITMQ_PASSWORD=<mismo valor que RABBITMQ_PASSWORD en el .env de producción>


# =============================================================================
# Fuera de alcance de este archivo (a propósito)
# =============================================================================
# Las variables de runtime de cada servicio (ConnectionStrings__Nexo,
# Database__Esquema, RABBITMQ_USER/PASSWORD del propio contenedor, las keys de
# Cubicador3D, SMTP, etc.) NO son GitHub Secrets — van en el Environment de
